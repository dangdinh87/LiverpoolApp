    "/_full",
    "/$d$locale",
    "/$d$locale/chat/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/66affdae550607ae46901573d9542bde7630b0db77a51368fd98e437dd1d096c/$/vi/chat",
    "owner": {
      "kind": "APP_PAGE",
      "sourceRoute": "/[locale]/chat/page"
    },
    "isFallback": false
  }
}