3f:["$","li","2014-2",{"className":"relative pb-8 pl-6 last:pb-0 sm:pl-8","children":[["$","span",null,{"aria-hidden":true,"className":"absolute -left-[5px] top-2 size-[9px] rounded-full bg-lfc-red"}],["$","article",null,{"className":"flex items-start gap-6","children":[["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"font-bebas text-3xl leading-none text-brand tabular-nums","children":2014}],["$","h4",null,{"className":"mt-1 text-lg font-bold leading-snug text-white","children":"Suýt chút nữa — Tiếc nuối lịch sử"}],["$","p",null,{"className":"mt-2 max-w-[60ch] text-[15px] leading-relaxed text-white/75","children":"Nỗi tiếc nuối lớn nhất của Liverpool thời hiện đại. Luis Suárez ghi 31 bàn tại Premier League khi đội bóng của Brendan Rodgers dẫn đầu bảng xếp hạng phần lớn mùa giải. Một pha vấp ngã của Steven Gerrard trước Chelsea đã tạo cơ hội cho Demba Ba ghi bàn, và Manchester City tận dụng cơ hội giành chức vô địch cách Liverpool 2 điểm. Suárez đoạt danh hiệu Vua phá lưới; mùa giải được nhớ đến như một trong những mùa đẹp và đau lòng nhất lịch sử Liverpool."}]]}],"$undefined"]}]]}]
