96:["$","$L7e",null,{"className":"text-[15px] leading-relaxed text-white/80","children":"Trung vệ xuất sắc nhất thế giới ở đỉnh cao phong độ. Sự xuất hiện của Van Dijk đã thay đổi hoàn toàn thành tích phòng ngự Liverpool và là trụ cột trong việc giành Champions League và Premier League. Một thủ lĩnh đầy uy quyền."}]
