1d:["$","div",null,{"className":"page-container","children":[["$","section",null,{"id":"timeline","className":"scroll-mt-[calc(var(--header-h)+3.5rem)] py-10 sm:py-14 ","children":[["$","div",null,{"className":"flex items-end justify-between gap-4 mb-4 sm:mb-6","children":[["$","div",null,{"className":"min-w-0","children":[["$","p",null,{"className":"section-label text-brand mb-1","children":"Lịch sử"}],["$","h2",null,{"className":"font-bebas text-3xl sm:text-4xl leading-[1.1] text-white text-balance","children":"Dòng thời gian"}]]}],"$undefined"]}],["$","p",null,{"className":"mb-8 hidden max-w-[65ch] text-[15px] leading-relaxed text-stadium-muted sm:block sm:text-base","children":"Liverpool FC ra đời từ một cuộc tranh chấp gay gắt. Năm 1892, Everton FC rời Anfield vì bất đồng về tiền thuê mặt bằng với chủ đất John Houlding. Bị bỏ lại với một sân vận động nhưng không có đội bóng, Houlding đã thành lập Câu lạc bộ Bóng đá Liverpool vào ngày 15 tháng 3 năm 1892. Câu lạc bộ được nhận vào Football League vào năm sau và giành chức vô địch quốc gia đầu tiên vào năm 1901. Những gì bắt đầu từ sự quyết tâm của một người đàn ông để lấp đầy một sân vận động trống đã phát triển thành một trong những câu lạc bộ bóng đá thành công và được yêu mến nhất thế giới."}],["$","div",null,{"className":"border-t border-[var(--line-strong)]","children":[["$","details","beginnings",{"id":"era-beginnings","open":true,"className":"group scroll-mt-[calc(var(--header-h)+4rem)] border-b border-[var(--line-strong)]","children":[["$","summary",null,{"className":"flex min-h-14 cursor-pointer list-none items-center gap-4 py-5 outline-none focus-visible:ring-2 focus-visible:ring-lfc-red focus-visible:ring-offset-2 focus-visible:ring-offset-stadium-bg sm:py-6 [&::-webkit-details-marker]:hidden","children":[["$","div",null,{"className":"flex min-w-0 flex-1 flex-wrap items-baseline gap-x-4 gap-y-1","children":[["$","p",null,{"className":"font-bebas text-2xl leading-none text-stadium-muted tabular-nums","c