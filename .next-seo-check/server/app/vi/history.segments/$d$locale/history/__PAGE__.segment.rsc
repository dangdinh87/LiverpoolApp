a0:["$","$L7e",null,{"className":"text-[15px] leading-relaxed text-white/80","children":"Hai lần đoạt Quả bóng Vàng và một trong những tiền đạo hấp dẫn nhất lịch sử Liverpool. Keegan đến từ Scunthorpe United với giá £33,000 năm 1971 và tạo nên bộ đôi tấn công chết chóc cùng John Toshack, giúp Liverpool giành 3 chức vô địch quốc gia, Cúp FA, 2 Cúp UEFA và Cúp C1 châu Âu. Rời đến Hamburg năm 1977 và giành 2 danh hiệu Cầu thủ xuất sắc nhất châu Âu liên tiếp."}]
a1:["$","p",null,{"className":"sr-only","children":"Hai lần đoạt Quả bóng Vàng và một trong những tiền đạo hấp dẫn nhất lịch sử Liverpool. Keegan đến từ Scunthorpe United với giá £33,000 năm 1971 và tạo nên bộ đôi tấn công chết chóc cùng John Toshack, giúp Liverpool giành 3 chức vô địch quốc gia, Cúp FA, 2 Cúp UEFA và Cúp C1 châu Âu. Rời đến Hamburg năm 1977 và giành 2 danh hiệu Cầu thủ xuất sắc nhất châu Âu liên tiếp."}]
