Liverpool","goalsByMonth":"Bàn thắng theo tháng","goalsByMonthSub":"Ghi bàn vs Thủng lưới — tất cả giải đấu","scored":"Ghi bàn","conceded":"Thủng lưới","homeAway":"Sân nhà vs Sân khách","homeAwaySub":"So sánh phong độ","home":"Nhà","away":"Khách","formTimeline":"Chuỗi phong độ","formTimelineSub":"{count} trận gần nhất · tất cả giải đấu","win":"Thắng","draw":"Hòa","loss":"Thua","months":{"jan":"Th1","feb":"Th2","mar":"Th3","apr":"Th4","may":"Th5","jun":"Th6","jul":"Th7","aug":"Th8","sep":"Th9","oct":"Th10","nov":"Th11","dec":"Th12"},"partialMonth":"đến nay","matchesShort":"trận"},"competitions":{"title":"Theo giải đấu","subtitle":"Mùa giải {season}","winRate":"Tỷ lệ thắng","gf":"BT","ga":"BB","gfLong":"Bàn thắng","gaLong":"Bàn thua"},"records":{"title":"Kỷ lục mùa giải","subtitle":"Tính đến hiện tại","biggestWin":"Thắng lớn nhất","biggestLoss":"Thua đậm nhất","highestScoring":"Nhiều bàn nhất","winStreak":"Chuỗi thắng","unbeatenStreak":"Chuỗi bất bại","comebacks":"Ngược dòng","scoringFirst":"Ghi bàn trước thắng %","matches":"trận","times":"lần"},"table":{"title":"Cầu thủ Liverpool ghi bàn ở Ngoại hạng Anh","goalsShort":"BT","assistsShort":"KT","player":"Cầu thủ","minutesShort":"Phút"},"comparison":{"title":"So sánh mùa giải","subtitle":"So sánh các mùa giải gần đây"},"noData":{"title":"Chưa có dữ liệu mùa này","description":"Chưa có dữ liệu trận đấu của mùa này. Bạn quay lại sau nhé.","action":"Xem lịch đấu"},"seasonPicker":"Chọn mùa giải","leaderboard":{"goals":"bàn","assists":"kiến tạo","rank":"Hạng {rank}","tiedRank":"Đồng hạng {rank}"}},"History":{"metadata":{"title":"Câu lạc bộ","description":"Liverpool FC — 20 chức vô địch Anh, 6 Cúp C1. Khám phá lịch sử, sân vận động, huyền thoại, truyền thống và hơn thế nữa."},"hero":{"est":"Thành lập 1892","trophies":"Danh hiệu lớn","foundingStory":"Liverpool FC ra đời từ một cuộc tranh chấp gay gắt. Năm 1892, Everton FC rời Anfield vì bất đồng về tiền thuê mặt bằng với chủ đất John Houlding. Bị bỏ lại với một sân vận động nhưng không có đội bóng, Houlding đã thành lập Câu lạc bộ Bóng đá Liverpool vào ngày 15 tháng 3 năm 1892. Câu lạc bộ được nhận vào Football League vào năm sau và giành chức vô địch quốc gia đầu tiên vào năm 1901. Những gì bắt đầu từ sự quyết tâm của một người đàn ông để lấp đầy một sân vận động trống đã phát triển thành một trong những câu lạc bộ bóng đá thành công và được yêu mến nhất thế giới.","tagline":"Từ năm 1892 — 20 chức vô địch Anh, 6 Cúp C1 và một Anfield."},"sections":{"profile":"Hồ sơ CLB","facts":"Thông tin chính","culture":"Văn hóa","traditions":"Truyền thống","allTime":"Mọi thời đại","records":"Kỷ lục CLB","layout":"Sơ đồ sân","stands":"4 Khán đài","iconic":"Địa danh biểu tượng","anfield":"Quanh Anfield","gallery":"Thư viện ảnh","photos":"Ảnh Anfield","glory":"Vinh quang","cabinet":"Phòng truyền thống","history":"Lịch sử","timeline":"Dòng thời gian","masterminds":"Bộ não chiến lược","managers":"Huấn luyện viên vĩ đại","immortals":"Những người bất tử","legends":"Huyền thoại","stadiumImages":"Hình ảnh sân vận động"},"facts":{"fullName":"Tên đầy đủ","founded":"Thành lập","founder":"Người sáng lập","nickname":"Biệt danh","captain":"Đội trưởng","manager":"HLV trưởng","owner":"Chủ sở hữu","chairman":"Chủ tịch","league":"Giải đấu","kitManufacturer":"Nhà tài trợ áo","website":"Trang web","colours":"Màu sắc","white":"Trắng"},"tradition":{"listen":"Nghe"},"records":{"topScorer":"Cầu thủ ghi bàn nhiều nhất","goalsCount":"{count} bàn thắng","appearances":"Ra sân nhiều nhất","appsCount":"{count} trận","signing":"Hợp đồng kỷ lục (Mùa)","sale":"Bán cầu thủ kỷ lục"},"legends":{"appearances":"Ra sân","goals":"Bàn thắng","close":"Đóng"},"stadium":{"fortress":"Pháo đài","capacity":"Sức chứa","opened":"Khánh thành","pitch":"Mặt sân","record":"Kỷ lục","seats":"Ghế"},"tabs":{"overview":"Tổng quan","anfield":"Anfield","gallery":"Thư viện","honours":"Vinh quang","timeline":"Dòng thời gian","legends":"Huyền thoại"},"nav":{"label":"Trong trang này","timeline":"Dòng thời gian","trophies":"Danh hiệu","legends":"Huyền thoại","stadium":"Sân vận động"},"trophies":{"years":"Các năm đăng quang"},"eras":{"events":"{count} mốc","now":"nay","beginnings":{"name":"Khởi đầu","summary":"Ra đời sau khi Everton rời Anfield, Liverpool có chức vô địch quốc gia đầu tiên chỉ trong một thập kỷ và trụ vững ở hạng Nhất."},"shankly":{"name":"Thời Shankly","summary":"Bill Shankly đến khi đội còn ở hạng Hai và dựng nên Liverpool hiện đại: lên hạng, vô địch, FA Cup đầu tiên và Boot Room."},"paisley":{"name":"Thời hoàng kim","summary":"Dưới thời Paisley, Fagan và Dalglish, Liverpool thống trị nước Anh và châu Âu, qua cả vinh quang lẫn bi kịch Heysel và Hillsborough."},"rebuild":{"name":"Tái thiết","summary":"Kỷ nguyên Premier League mang về các cúp thay vì chức vô địch, cùng hai đêm bất tử: cú ăn ba cúp 2001 và Istanbul 2005."},"klopp":{"name":"Thời Klopp","summary":"Jürgen Klopp biến hoài nghi thành niềm tin: Cúp C1 thứ sáu năm 2019 và chức vô địch quốc gia năm 2020 sau ba mươi năm chờ đợi."},"today":{"name":"Hiện tại","summary":"Huấn luyện viên mới, đội hình mới và cùng một kỳ vọng ở Anfield."}}},"About":{"metadata":{"title":"Giới thiệu","description":"Anfield Daily là trang fan Liverpool không chính thức, gom tin từ các báo Anh và tóm tắt mỗi ngày. Dữ liệu lấy từ đâu, và trang này không phải cái gì."},"label":"Giới thiệu","eyebrow":{"story":"Về trang","features":"Tính năng","news":"Tin tức","ai":"AI","data":"Nguồn","support":"Góp sức"},"title":"Tin Liverpool, tổng hợp và tóm tắt","disclaimer":"{brand} là trang fan <status>độc lập, không chính thức</status>. Trang không liên kết với, không được tài trợ hay xác nhận bởi Liverpool FC, Fenway Sports Group, Premier League hoặc các tờ báo được dẫn link. Tên, logo và nhãn hiệu thuộc về chủ sở hữu tương ứng.","whatIs":{"title":"{brand} là gì?","description":"Anfield Daily là trang của một fan Liverpool, làm ra để đọc tin cho nhanh. Trang gom tin từ các báo Anh và tiếng Việt, bỏ các bài trùng nhau và tóm tắt cả ngày thành một bản tin ngắn, để bạn khỏi phải mở hai mươi tab. Lịch thi đấu, kết quả và bảng xếp hạng nằm ngay bên cạnh.","featuresTitle":"Trong trang có gì","features":{"gathered":{"title":"Tin gom sẵn","body":"Tin từ các báo Anh trong một dòng tin, mỗi tin kèm link sang bài gốc."},"dedupe":{"title":"Lọc bài trùng","body":"Cùng một tin từ năm tờ báo chỉ hiện một lần, không phải năm lần."},"digest":{"title":"Bản tin mỗi ngày","body":"Tin cả ngày gói trong một bản tin ngắn do AI soạn nháp, đọc nhanh là nắm được."},"fixtures":{"title":"Lịch & kết quả","body":"Giờ đá theo múi giờ của bạn và kết quả: Ngoại hạng Anh, Champions League, FA Cup, EFL Cup."},"spoiler":{"title":"Không spoil","body":"Ẩn tỷ số và kết quả trên toàn trang tới khi bạn muốn xem. Tiện khi xem lại trận."},"calendar":{"title":"Đồng bộ lịch","body":"Mọi trận Liverpool trong lịch điện thoại theo giờ của bạn, có nhắc trước giờ bóng lăn."},"predictions":{"title":"Dự đoán & chấm điểm","body":"Đoán tỷ số, chấm điểm cầu thủ và xem thứ hạng so với fan khác. Cần đăng nhập."},"club":{"title":"Đội hình & CLB","body":"Đội hình và hồ sơ từng cầu thủ, bảng xếp hạng, lịch sử CLB và sân Anfield. Tài khoản (không bắt buộc) để lưu mục yêu thích."}},"dataTitle":"Nguồn dữ liệu","dataSources":"Lịch đấu, kết quả, bảng xếp hạng: football-data.org và ESPN. Thống kê cầu thủ: Fantasy Premier League (API công khai). Đội hình và hồ sơ cầu thủ: liverpoolfc.com. Tiêu đề tin: RSS công khai của các báo Anh, luôn kèm link bài gốc.","techTitle":"Công nghệ","techStack":"Next.js 16 (App Router, ISR) · React 19 · TypeScript · Tailwind CSS 4 · shadcn/ui · Framer Motion · Recharts · Supabase (Auth + PostgreSQL + Storage) · next-intl (EN/VI)"},"creator":{"title":"Người làm trang","role":"Lập trình viên, fan Liverpool","bio":"Mình là lập trình viên và là fan Liverpool. Anfield Daily là dự án làm lúc rảnh, để mình (và bạn) đọc tin Liverpool mỗi ngày cho nhanh, khỏi lùng từng báo."},"contact":{"title":"Liên hệ","description":"Muốn góp ý, báo lỗi hoặc đề nghị chỉnh sửa nội dung? Cứ nhắn mình.","email":"Email","github":"GitHub","githubUrl":"https://github.com/dangdinh87","phone":"Điện thoại"},"support":{"title":"Ủng hộ trang","description":"{brand} miễn phí. Nếu thấy hữu ích, bạn có thể góp một ly cà phê để mình trả tiền máy chủ và API.","buyCoffee":"Mời mình ly cà phê","momoAlt":"QR MoMo - Nguyễn Đăng Định","momoTitle":"Mã QR MoMo"},"tagline":"Tin nhanh, bản tin tóm tắt mỗi ngày, lịch thi đấu và kết quả cho fan Liverpool.","news":{"title":"Tin tức được xử lý thế nào","body":"Mục tin nhanh chỉ hiện tiêu đề, một đoạn trích ngắn và link sang bài gốc. Muốn đọc đầy đủ, bạn mở bài trên trang của báo đó. {brand} không đăng lại toàn văn bài báo. Nếu bạn là tác giả hoặc tòa soạn và muốn chỉnh hay gỡ một mục, hãy gửi email để mình xem xét."},"ai":{"title":"AI trên {brand}","body":"Reds AI (chat), bản dịch đoạn trích tin và bản tin tổng hợp hằng ngày có AI hỗ trợ. AI có thể trả lời sai hoặc thiếu cập nhật. Với thông tin quan trọng như giờ đá hay vé, hãy đối chiếu với nguồn chính thức của CLB."}},"Standings":{"metadata":{"title":"Bảng xếp hạng","description":"Bảng xếp hạng Ngoại hạng Anh {season}: điểm, hiệu số, phong độ và vị trí của Liverpool."},"hero":{"season":"Ngoại hạng Anh · {season}","title":"Bảng xếp hạng","lfcPosition":"Liverpool FC · Hạng {rank}","points":"{count} điểm","suffixes":{"st":"","nd":"","rd":"","th":""}},"rank":"Hạng","club":"CLB","played":"Trận","win":"T","draw":"H","lose":"B","gf":"BT","ga":"BB","gd":"HS","pts":"Điểm","form":"Phong độ","progressBar":{"label":"Liverpool"},"zones":{"cl":"Dự Champions League","el":"Dự Europa League","ecl":"Dự Conference League","rel":"Xuống hạng","r16":"Vào vòng 1/8","playoff":"Vào vòng play-off","elim":"Bị loại"},"description":"Bảng xếp hạng Premier League mới nhất.","compLabel":"Giải đấu","outage":{"title":"Chưa có bảng xếp hạng","description":"Chưa tải được bảng xếp hạng. Bạn thử lại sau vài phút nhé.","action":"Xem tin nhanh"},"summary":{"label":"Liverpool trên bảng xếp 