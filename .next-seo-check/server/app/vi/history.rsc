ef:["$","li","2020-3",{"className":"relative pb-8 pl-6 last:pb-0 sm:pl-8","children":[["$","span",null,{"aria-hidden":true,"className":"absolute -left-[5px] top-2 size-[9px] rounded-full bg-lfc-red"}],["$","article",null,{"className":"flex items-start gap-6","children":[["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"font-bebas text-3xl leading-none text-brand tabular-nums","children":2020}],["$","h4",null,{"className":"mt-1 text-lg font-bold leading-snug text-white","children":"Vô địch Ngoại hạng Anh"}],["$","p",null,{"className":"mt-2 max-w-[60ch] text-[15px] leading-relaxed text-white/75","children":"Liverpool kết thúc 30 năm chờ đợi chức vô địch giải đấu, đăng quang Premier League trước 7 vòng đấu — sớm nhất lịch sử Ngoại hạng Anh. Đội bóng của Klopp tích lũy 99 điểm và chỉ thua 3 trận suốt mùa giải."}]]}],"$undefined"]}]]}]
f0:["$","li","2022-4",{"className":"relative pb-8 pl-6 last:pb-0 sm:pl-8","children":[["$","span",null,{"aria-hidden":true,"className":"absolute -left-[5px] top-2 size-[9px] rounded-full bg-lfc-red"}],["$","article",null,{"className":"flex items-start gap-6","children":[["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"font-bebas text-3xl leading-none text-brand tabular-nums","children":2022}],["$","h4",null,{"className":"mt-1 text-lg font-bold leading-snug text-white","children":"Gần như cú tứ kép lịch sử"}],["$","p",null,{"className":"mt-2 max-w-[60ch] text-[15px] leading-relaxed text-white/75","children":"Liverpool của Klopp chỉ trong gang tấc giành cú tứ kép chưa từng có. Họ đã giành Cúp FA và Cúp Liên đoàn — đánh bại Chelsea trên chấm luân lưu trong cả hai trận chung kết tại Wembley — nhưng chỉ hụt chức vô địch Premier League so với Manchester City đúng 1 điểm và thua Real Madrid trong trận chung kết Champions League tại Paris. Đây là một trong những mùa giải phi thường nhất lịch sử bóng đá Anh."}]]}],"$undefined"]}]]}]
