b:["$","p","3",{"children":"Trang có hiển thị quảng cáo của Google AdSense; Google và các đối tác có thể dùng cookie để phân phát quảng cáo, và bạn có thể tắt quảng cáo cá nhân hóa trong Cài đặt quảng cáo của Google."}]
c:["$","section","terms",{"id":"terms","className":"scroll-mt-[calc(var(--header-h)+1rem)]","children":[["$","h2",null,{"className":"font-bebas text-3xl text-white sm:text-4xl","children":"Điều khoản sử dụng"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-[1.7] text-stadium-muted","children":[["$","p","0",{"children":"Trang web này được cung cấp nguyên trạng chỉ cho mục đích thông tin và giải trí. Anfield Daily là trang fan không chính thức, không liên kết với Liverpool FC hay Premier League."}],["$","p","1",{"children":"Tất cả các nhãn hiệu, logo và các yếu tố thương hiệu của Liverpool FC là tài sản của Liverpool Football Club và Athletic Grounds Limited. Dữ liệu trận đấu được lấy từ Football-Data.org và ESPN."}],["$","p","2",{"children":"Mục tin nhanh chỉ hiển thị tiêu đề, đoạn trích ngắn và liên kết tới bài gốc; mọi quyền đối với bài viết thuộc về báo hoặc tác giả gốc, và Anfield Daily không đăng lại toàn văn. Các tính năng AI (chat, dịch bài, tổng hợp tin hàng ngày) được hỗ trợ bởi VietAPI, kèm Groq cho tìm kiếm web."}],["$","p","3",{"children":"Việc sử dụng trang web này có nghĩa là bạn chấp nhận các điều khoản này."}]]}]]}]
d:["$","section","sources",{"id":"sources","className":"scroll-mt-[calc(var(--header-h)+1rem)]","children":[["$","h2",null,{"className":"font-bebas text-3xl text-white sm:text-4xl","children":"Nguồn dữ liệu"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-[1.7] text-stadium-muted","children":[["$","p","0",{"children":"Bảng xếp hạng, lịch thi đấu và kết quả được cung cấp bởi Football-Data.org. Lịch thi đấu cúp và diễn biến trận đấu được bổ sung từ ESPN."}],["$","p","1",{"children":"Thống kê cầu thủ lấy từ Fantasy Premier League (API công khai); đội hình và hồ sơ cầu thủ lấy từ liverpoolfc.com. Tin nhanh lấy tiêu đề và đoạn trích ngắn từ RSS công khai của các báo, kèm liên kết tới bài gốc — gồm LFC Official, BBC Sport, The Guardian, Liverpool Echo, This Is Anfield, Anfield Watch, Empire of the Kop, Sky Sports, The Mirror, The Independent, Anfield Index, Liverpool.com và ESPN."}],["$","p","2",{"children":"Chat AI, dịch bài viết và bản tin tổng hợp hằng ngày được hỗ trợ bởi VietAPI; bản tin tổng hợp do AI soạn nháp nên có thể có sai sót. Tìm kiếm web trong chat dùng Groq."}],["$","p","3",{"children":"Hình ảnh gallery được lưu trữ trên Cloudinary. Dữ liệu lịch sử và thông tin danh hiệu được duy trì bởi quản trị viên dựa trên các nguồn công khai."}]]}]]}]
