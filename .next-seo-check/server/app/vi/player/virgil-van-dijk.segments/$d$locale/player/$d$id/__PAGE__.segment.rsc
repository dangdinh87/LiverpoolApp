3d:["$","div","https://www.theguardian.com/football/2026/oct/12/virgil-van-dijk-warns-manchester-city-players-to-get-used-to-hostile-atmospheres",{"className":"hidden sm:hidden lg:block","children":["$","$L2a",null,{"href":"/vi/news/guardian/football/2026/oct/12/virgil-van-dijk-warns-manchester-city-players-to-get-used-to-hostile-atmospheres","localeCookie":"$1b:props:children:1:props:children:0:props:localeCookie","className":"group flex min-h-[104px] gap-3 border-b border-[var(--line)] py-3.5 transition-colors sm:block sm:min-h-0 sm:overflow-hidden sm:border sm:bg-[var(--surface-2)] sm:p-0 sm:hover:border-[var(--line-strong)] sm:hover:bg-[var(--surface-3)]","children":[["$","div",null,{"className":"relative order-2 aspect-[4/3] shrink-0 self-start bg-[var(--surface-3)] w-[104px] sm:w-full sm:aspect-video","children":["$","$L38",null,{"src":"https://i.guim.co.uk/img/media/3d3d8e433bf9d74ef041e82a437bc4a09113328b/173_199_3776_3021/master/3776.jpg?width=140&quality=85&auto=format&fit=max&s=b0f6a75b65d73ce4da9f8c64e4607cdd","source":"guardian","sizes":"(max-width: 640px) 104px, (max-width: 1024px) 50vw, 360px","priority":false}]}],["$","div",null,{"className":"order-1 flex min-w-0 flex-1 flex-col gap-1.5 sm:gap-2 sm:p-4","children":[["$","h3",null,{"className":"line-clamp-3 font-inter text-base font-bold leading-[1.35] decoration-lfc-red decoration-2 underline-offset-4 group-hover:underline text-white","children":"Virgil van Dijk warns Manchester City players to get used to hostile atmospheres"}],["$","p",null,{"className":"text-sm leading-relaxed text-stadium-muted line-clamp-2 max-sm:hidden","children":"Liverpool captain says players heard ‘cheat’ chants ‘I don’t think Anfield will be the only place’ Virgil van Dijk has suggested Manchester City’s treatment at the hands of the Liverpool crowd on Sunday was a sign of things to come and something their players will have to get used to. The Liverpool captain also indicated he would make his views known about City’s rule-breaking but said he wanted to wait until their appeal was completed. City were barracked throughout the game at Anfield, their first since they were found guilty of almost all the charges they faced in relation to breaking the…"}],["$","p",null,{"className":"mt-auto text-[13px] leading-snug text-stadium-muted","children":"The Guardian · 1 ngày trước"}]]}]]}]}]
3e:["$","p","3",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Sau khi Jordan Henderson ra đi tháng 7 năm 2023, đội trưởng tuyển Hà Lan Van Dijk chính thức được bổ nhiệm làm đội trưởng mới của đội. Thêm danh hiệu đánh dấu mùa giải đầu tiên đeo băng đội trưởng khi Van Dijk đánh đầu ghi bàn quyết định giúp Liverpool đánh bại Chelsea trong trận chung kết Carabao Cup 2024 tại Wembley. Cuối mùa 2024-25, khi anh cán mốc 300 trận cho câu lạc bộ, Van Dijk cam kết tương lai bằng hợp đồng mới."}]
