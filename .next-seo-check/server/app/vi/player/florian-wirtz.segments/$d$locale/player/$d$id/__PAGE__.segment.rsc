36:["$","div","https://www.liverpool.com/liverpool-fc-news/features/jamie-carraghers-full-verdict-florian-34753872",{"className":"hidden sm:hidden lg:block","children":["$","$L2a",null,{"href":"/vi/news/liverpoolcom/liverpool-fc-news/features/jamie-carraghers-full-verdict-florian-34753872","localeCookie":"$1b:props:children:1:props:children:0:props:localeCookie","className":"group flex min-h-[104px] gap-3 border-b border-[var(--line)] py-3.5 transition-colors sm:block sm:min-h-0 sm:overflow-hidden sm:border sm:bg-[var(--surface-2)] sm:p-0 sm:hover:border-[var(--line-strong)] sm:hover:bg-[var(--surface-3)]","children":[["$","div",null,{"className":"relative order-2 aspect-[4/3] shrink-0 self-start bg-[var(--surface-3)] w-[104px] sm:w-full sm:aspect-video","children":["$","$L3b",null,{"src":"https://i2-prod.liverpool.com/liverpool-fc-news/features/article34753869.ece/ALTERNATES/s615/0_Carragher-2.jpg","source":"liverpoolcom","sizes":"(max-width: 640px) 104px, (max-width: 1024px) 50vw, 360px","priority":false}]}],["$","div",null,{"className":"order-1 flex min-w-0 flex-1 flex-col gap-1.5 sm:gap-2 sm:p-4","children":[["$","h3",null,{"className":"line-clamp-3 font-inter text-base font-bold leading-[1.35] decoration-lfc-red decoration-2 underline-offset-4 group-hover:underline text-white","children":"Jamie Carragher's full verdict on Florian Wirtz as time has come for tough decision"}],["$","p",null,{"className":"text-sm leading-relaxed text-stadium-muted line-clamp-2 max-sm:hidden","children":"Florian Wirtz has struggled to make his mark at Liverpool since his move from Bayer Leverkusen, and Jamie Carragher has called for the Germany international to be dropped from the starting XI"}],["$","p",null,{"className":"mt-auto text-[13px] leading-snug text-stadium-muted","children":"Liverpool.com · 1 ngày trước"}]]}]]}]}]
37:["$","section",null,{"children":[["$","div",null,{"className":"flex items-end justify-between gap-4 mb-4 sm:mb-6","children":[["$","div",null,{"className":"min-w-0","children":["$undefined",["$","h2",null,{"className":"font-bebas text-3xl sm:text-4xl leading-[1.1] text-white text-balance","children":"Tiểu sử"}]]}],"$undefined"]}],["$","div",null,{"className":"max-w-[65ch] space-y-4","children":[[["$","p","0",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Florian Wirtz gia nhập Liverpool vào tháng 6 năm 2025 sau khi khẳng định mình là một trong những tài năng hàng đầu thế hệ tại Đức. Tiền vệ tấn công tài hoa, thoải mái cả trong việc ghi bàn lẫn kiến tạo, anh trưởng thành qua mười năm tại Cologne trước khi chuyển đến Bayer Leverkusen đầu năm 2020 và thực sự bắt đầu thăng tiến. Wirtz ra mắt Leverkusen chỉ hai tuần sau sinh nhật 17 tuổi vào tháng 5 năm đó và vài tuần sau đã mở tài khoản ở Bundesliga – bàn thắng vào lưới Bayern Munich khiến anh trở thành cầu thủ trẻ nhất ghi bàn trong lịch sử giải đấu thời điểm đó."}],["$","p","1",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Anh nhanh chóng được tích hợp vào đội một với 69 lần ra sân ở mọi đấu trường trong hai mùa tiếp theo, ghi 18 bàn. Tốc độ phát triển được phản ánh qua việc trở thành cầu thủ trẻ nhất cán mốc 50 trận ở Bundesliga. Giữa chừng, Wirtz là thành viên đội tuyển Đức vô địch U21 Euro 2021, ghi cả hai bàn trong trận bán kết thắng Hà Lan và đá chính trận chung kết thắng Bồ Đào Nha."}]],["$","details",null,{"className":"group space-y-4","children":[["$","summary",null,{"className":"inline-flex min-h-11 cursor-pointer list-none items-center gap-2 font-barlow text-sm font-semibold uppercase tracking-[0.12em] text-brand outline-none hover:text-white focus-visible:ring-2 focus-visible:ring-lfc-red [&::-webkit-details-marker]:hidden","children":[["$","span",null,{"className":"group-open:hidden","children":"Đọc thêm"}],["$","span",null,{"className":"hidden group-open:inline","children":"Thu gọn"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down transition-transform group-open:rotate-180","aria-hidden":true,"children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],[["$","p","0",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Chấn thương dây chằng chéo trước tháng 3 năm 2022 tạm thời cản trở sự phát triển và khiến anh nghỉ đến tháng 1 năm sau. Nhưng anh trở lại mạnh mẽ hơn bao giờ hết và mùa 2023-24 trở thành bước ngoặt lịch sử cho cả cá nhân và tập thể Leverkusen. Dưới sự dẫn dắt của cựu tiền vệ Liverpool Xabi Alonso, Wirtz là nhân vật chủ chốt trong mùa giải khó tin khi Bayer đi qua cả mùa Bundesliga bất bại."}],["$","p","1",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Thực tế họ chỉ thua một trong 53 trận, hoàn thành cú đúp với cúp quốc gia Đức và suýt có cú ăn ba khi thua Atalanta ở chung kết Europa League. Đóng góp cá nhân của Wirtz bao gồm 49 trận đấu và 38 lần tham gia bàn thắng ấn tượng – 18 bàn thắng và 20 kiến tạo. Anh xứng đáng được vinh danh Cầu thủ xuất sắc nhất mùa Bundesliga sau vai trò then chốt trong chức vô địch đầu tiên của Leverkusen kể từ khi thành lập năm 1904."}],["$","p","2",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Mới 21 tuổi, Wirtz ra sân năm trận cho đội tuyển Đức tại Euro 2024 và ghi hai bàn, bao gồm một bàn vào sân thay người ở trận tứ kết thua Tây Ban Nha, đội vô địch giải đấu. Sự quan tâm chiêu mộ anh ngày càng tăng, nhưng Wirtz ở lại Leverkusen mùa 2024-25. Và sản lượng tiếp tục ấn tượng với 31 lần tham gia bàn thắng (16 bàn, 15 kiến tạo) từ 45 trận, bao gồm lần đầu chơi Champions League."}],"$L3c"]]}]]}]]}]
38:["$","div",null,{"className":"flex flex-col items-center gap-1 sm:flex-row sm:justify-between","children":[["$","$L2a",null,{"href":"/vi/squad","localeCookie":"$1b:props:children:1:props:children:0:props:localeCookie","className":"group inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-white transition-colors hover:text-brand","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left transition-transform group-hover:-translate-x-1","aria-hidden":true,"children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}],"Về đội hình"]}],["$","a",null,{"href":"https://www.liverpoolfc.com/team/mens/player/florian-wirtz","target":"_blank","rel":"noopener noreferrer","className":"inline-flex min-h-11 items-center gap-2 text-sm text-stadium-muted transition-colors hover:text-white","children":["Xem trên liverpoolfc.com",["$","svg",null,{"aria-hidden":true,"className":"size-3.5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":2,"children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"}]}]]}]]}]
