ưng không có đội bóng, Houlding đã thành lập Câu lạc bộ Bóng đá Liverpool vào ngày 15 tháng 3 năm 1892. Câu lạc bộ được nhận vào Football League vào năm sau và giành chức vô địch quốc gia đầu tiên vào năm 1901. Những gì bắt đầu từ sự quyết tâm của một người đàn ông để lấp đầy một sân vận động trống đã phát triển thành một trong những câu lạc bộ bóng đá thành công và được yêu mến nhất thế giới.","tagline":"Từ năm 1892 — 20 chức vô địch Anh, 6 Cúp C1 và một Anfield."},"sections":{"profile":"Hồ sơ CLB","facts":"Thông tin chính","culture":"Văn hóa","traditions":"Truyền thống","allTime":"Mọi thời đại","records":"Kỷ lục CLB","layout":"Sơ đồ sân","stands":"4 Khán đài","iconic":"Địa danh biểu tượng","anfield":"Quanh Anfield","gallery":"Thư viện ảnh","photos":"Ảnh Anfield","glory":"Vinh quang","cabinet":"Phòng truyền thống","history":"Lịch sử","timeline":"Dòng thời gian","masterminds":"Bộ não chiến lược","managers":"Huấn luyện viên vĩ đại","immortals":"Những người bất tử","legends":"Huyền thoại","stadiumImages":"Hình ảnh sân vận động"},"facts":{"fullName":"Tên đầy đủ","founded":"Thành lập","founder":"Người sáng lập","nickname":"Biệt danh","captain":"Đội trưởng","manager":"HLV trưởng","owner":"Chủ sở hữu","chairman":"Chủ tịch","league":"Giải đấu","kitManufacturer":"Nhà tài trợ áo","website":"Trang web","colours":"Màu sắc","white":"Trắng"},"tradition":{"listen":"Nghe"},"records":{"topScorer":"Cầu thủ ghi bàn nhiều nhất","goalsCount":"{count} bàn thắng","appearances":"Ra sân nhiều nhất","appsCount":"{count} trận","signing":"Hợp đồng kỷ lục (Mùa)","sale":"Bán cầu thủ kỷ lục"},"legends":{"appearances":"Ra sân","goals":"Bàn thắng","close":"Đóng"},"stadium":{"fortress":"Pháo đài","capacity":"Sức chứa","opened":"Khánh thành","pitch":"Mặt sân","record":"Kỷ lục","seats":"Ghế"},"tabs":{"overview":"Tổng quan","anfield":"Anfield","gallery":"Thư viện","honours":"Vinh quang","timeline":"Dòng thời gian","legends":"Huyền thoại"},"nav":{"label":"Trong trang này","timeline":"Dòng thời gian","trophies":"Danh hiệu","legends":"Huyền thoại","stadium":"Sân vận động"},"trophies":{"years":"Các năm đăng quang"},"eras":{"events":"{count} mốc","now":"nay","beginnings":{"name":"Khởi đầu","summary":"Ra đời sau khi Everton rời Anfield, Liverpool có chức vô địch quốc gia đầu tiên chỉ trong một thập kỷ và trụ vững ở hạng Nhất."},"shankly":{"name":"Thời Shankly","summary":"Bill Shankly đến khi đội còn ở hạng Hai và dựng nên Liverpool hiện đại: lên hạng, vô địch, FA Cup đầu tiên và Boot Room."},"paisley":{"name":"Thời hoàng kim","summary":"Dưới thời Paisley, Fagan và Dalglish, Liverpool thống trị nước Anh và châu Âu, qua cả vinh quang lẫn bi kịch Heysel và Hillsborough."},"rebuild":{"name":"Tái thiết","summary":"Kỷ nguyên Premier League mang về các cúp thay vì chức vô địch, cùng hai đêm bất tử: cú ăn ba cúp 2001 và Istanbul 2005."},"klopp":{"name":"Thời Klopp","summary":"Jürgen Klopp biến hoài nghi thành niềm tin: Cúp C1 thứ sáu năm 2019 và chức vô địch quốc gia năm 2020 sau ba mươi năm chờ đợi."},"today":{"name":"Hiện tại","summary":"Huấn luyện viên mới, đội hình mới và cùng một kỳ vọng ở Anfield."}}},"About":{"metadata":{"title":"Giới thiệu","description":"Anfield Daily là trang fan Liverpool không chính thức, gom tin từ các báo Anh và tóm tắt mỗi ngày. Dữ liệu lấy từ đâu, và trang này không phải cái gì."},"label":"Giới thiệu","eyebrow":{"story":"Về trang","features":"Tính năng","news":"Tin tức","ai":"AI","data":"Nguồn","support":"Góp sức"},"title":"Tin Liverpool, tổng hợp và tóm tắt","disclaimer":"{brand} là trang fan <status>độc lập, không chính thức</status>. Trang không liên kết với, không được tài trợ hay xác nhận bởi Liverpool FC, Fenway Sports Group, Premier League hoặc các tờ báo được dẫn link. Tên, logo và nhãn hiệu thuộc về chủ sở hữu tương ứng.","whatIs":{"title":"{brand} là gì?","description":"Anfield Daily là trang của một fan Liverpool, làm ra để đọc tin cho nhanh. Trang gom tin từ các báo Anh và tiếng Việt, bỏ các bài trùng nhau và tóm tắt cả ngày thành một bản tin ngắn, để bạn khỏi phải mở hai mươi tab. Lịch thi đấu, kết quả và bảng xếp hạng nằm ngay bên cạnh.","featuresTitle":"Trong trang có gì","features":{"gathered":{"title":"Tin gom sẵn","body":"Tin từ các báo Anh trong một dòng tin, mỗi tin kèm link sang bài gốc."},"dedupe":{"title":"Lọc bài trùng","body":"Cùng một tin từ năm tờ báo chỉ hiện một lần, không phải năm lần."},"digest":{"title":"Bản tin mỗi ngày","body":"Tin cả ngày gói trong một bản tin ngắn do AI soạn nháp, đọc nhanh là nắm được."},"fixtures":{"title":"Lịch & kết quả","body":"Giờ đá theo múi giờ của bạn và kết quả: Ngoại hạng Anh, Champions League, FA Cup, EFL Cup."},"spoiler":{"title":"Không spoil","body":"Ẩn tỷ số và kết quả trên toàn trang tới khi bạn muốn xem. Tiện khi xem lại trận."},"calendar":{"title":"Đồng bộ lịch","body":"Mọi trận Liverpool trong lịch điện thoại theo giờ của bạn, có nhắc trước giờ bóng lăn."},"predictions":{"title":"Dự đoán & chấm điểm","body":"Đoán tỷ số, chấm điểm cầu thủ và xem thứ hạng so với fan khác. Cần đăng nhập."},"club":{"title":"Đội hình & CLB","body":"Đội hình và hồ sơ từng cầu thủ, bảng xếp hạng, lịch sử CLB và sân Anfield. Tài khoản (không bắt buộc) để lưu mục yêu thích."}},"dataTitle":"Nguồn dữ liệu","dataSources":"Lịch đấu, kết quả, bảng xếp hạng: football-data.org và ESPN. Thống kê cầu thủ: Fantasy Premier League (API công khai). Đội hình và hồ sơ cầu thủ: liverpoolfc.com. Tiêu đề tin: RSS công khai của các báo Anh, luôn kèm link bài gốc.","techTitle":"Công nghệ","techStack":"Next.js 16 (App Router, ISR) · React 19 · TypeScript · Tailwind CSS 4 · shadcn/ui · Framer Motion · Recharts · Supabase (Auth + PostgreSQL + Storage) · next-intl (EN/VI)"},"creator":{"title":"Người làm trang","role":"Lập trình viên, fan Liverpool","bio":"Mình là lập trình viên và là fan Liverpool. Anfield Daily là dự án làm lúc rảnh, để mình (và bạn) đọc tin Liverpool mỗi ngày cho nhanh, khỏi lùng từng báo."},"contact":{"title":"Liên hệ","description":"Muốn góp ý, báo lỗi hoặc đề n