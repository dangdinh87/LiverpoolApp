33:["$","section",null,{"children":[["$","div",null,{"className":"flex items-end justify-between gap-4 mb-4 sm:mb-6","children":[["$","div",null,{"className":"min-w-0","children":["$undefined",["$","h2",null,{"className":"font-bebas text-3xl sm:text-4xl leading-[1.1] text-white text-balance","children":"Tiểu sử"}]]}],"$undefined"]}],["$","div",null,{"className":"max-w-[65ch] space-y-4","children":[[["$","p","0",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Trey Nyoni gia nhập Liverpool FC từ Leicester City tháng 9 năm 2023 và ký hợp đồng chuyên nghiệp đầu tiên hơn một năm sau đó. Là tiền vệ tấn công, Nyoni bắt đầu thời gian tại đội với đội U18 và ghi bàn thắng ở phút bù giờ trước Everton ngay trận ra mắt sân nhà. Tuyển thủ trẻ Anh tiếp tục chơi cho đội U21 và ra mắt đội một trước khi kết thúc mùa 2023-24."}],["$","p","1",{"className":"text-base leading-[1.7] text-white/85 sm:text-[17px]","children":"Mới 16 tuổi, Nyoni vào sân thay người trong trận FA Cup vòng năm thắng Southampton tại Anfield. Mùa hè 2024, Nyoni góp mặt cùng đội một trong chuyến du đấu trước mùa giải tại Mỹ và ghi bàn trong trận giao hữu thắng Sevilla tại Anfield. Sau đó anh trở thành cầu thủ trẻ nhất lịch sử câu lạc bộ thi đấu ở đấu trường châu Âu khi vào sân ở trận Champions League tại PSV Eindhoven tháng 1 năm 2025 ở tuổi 17 năm bảy tháng."}]],["$","details",null,{"className":"group space-y-4","children":[["$","summary",null,{"className":"inline-flex min-h-11 cursor-pointer list-none items-center gap-2 font-barlow text-sm font-semibold uppercase tracking-[0.12em] text-brand outline-none hover:text-white focus-visible:ring-2 focus-visible:ring-lfc-red [&::-webkit-details-marker]:hidden","children":[["$","span",null,{"className":"group-open:hidden","children":"Đọc thêm"}],["$","span",null,{"className":"hidden group-open:inline","children":"Thu gọn"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","st