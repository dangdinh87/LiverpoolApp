e9:["$","li","2022-4",{"className":"relative pb-8 pl-6 last:pb-0 sm:pl-8","children":[["$","span",null,{"aria-hidden":true,"className":"absolute -left-[5px] top-2 size-[9px] rounded-full bg-lfc-red"}],["$","article",null,{"className":"flex items-start gap-6","children":[["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"font-bebas text-3xl leading-none text-brand tabular-nums","children":2022}],["$","h4",null,{"className":"mt-1 text-lg font-bold leading-snug text-white","children":"The Near Quadruple"}],["$","p",null,{"className":"mt-2 max-w-[60ch] text-[15px] leading-relaxed text-white/75","children":"Klopp's Liverpool came within touching distance of an unprecedented quadruple. They won the FA Cup and League Cup — defeating Chelsea on penalties in both Wembley finals — but narrowly lost the Premier League title to Manchester City by just one point and fell to Real Madrid in the Champions League final in Paris. The season stands as one of the most extraordinary in English football history."}]]}],"$undefined"]}]]}]
