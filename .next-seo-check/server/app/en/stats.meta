{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/stats/layout,_N_T_/[locale]/stats/page,_N_T_/en/stats"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/stats/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/d6b556407dfd9945a2807c9ea39a6570e61cc5f31d800c7ef83a9c7a335a98fe/$/en/stats",
    "owner": {
      "kind": "APP_PAGE",
      "sourceRoute": "/[locale]/stats/page"
    },
    "isFallback": false
  }
}