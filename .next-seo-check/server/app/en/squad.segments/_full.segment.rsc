e","less":"Show less"},"fanRating":{"title":"Fans’ rating this season","detail":"Average over {matches, plural, one {# match} other {# matches}}, {votes} ratings from fans on the match pages."}},"Season":{"metadata":{"title":"Fixtures & table by season","description":"Look back at Liverpool's fixtures, results and Premier League table season by season, latest {season}."},"title":"Fixtures & table by season","stats":{"goals":"LFC Goals","assists":"LFC Assists","topScorer":"Top Scorer"},"charts":{"scorers":"Top Scorers","assists":"Top Assists","lfcScorers":"Liverpool Scorers","legend":"Premier League {season} · Red = Liverpool"},"table":{"title":"Liverpool Scorers","goals":"Goals","assists":"Assists","apps":"Apps"},"noData":{"title":"No Data Available","description":"Statistics for this season are not available on the free API tier."},"chips":{"pos":"Pos","pts":"Pts","form":"Form"},"next":"Next: ","vs":"vs ","at":"@ ","seasonSelect":"Select season","tabs":{"fixtures":"Fixtures","standings":"Table"},"hero":{"eyebrow":"Premier League · {season}","description":"Fixtures, results and the table, season by season."},"tabsLabel":"Fixtures or table","outage":{"title":"Season data is unavailable","description":"We could not load fixtures and the table. Please try again in a few minutes.","action":"Read quick news"}},"Stats":{"metadata":{"title":"Statistics","description":"Liverpool stats for {season}: wins, draws, losses, goals, top scorers, form and records."},"hero":{"season":"Season {season} · All Competitions","seasonLabel":"Season","title":"Statistics","description":"Wins, draws, losses, goals, top scorers, form and records for Liverpool this season."},"overview":{"title":"Season Overview","allCompsLabel":"All Competitions","played":"Played","wins":"Wins","draws":"Draws","losses":"Losses","goalsFor":"Goals For","goalsAgainst":"Goals Against","goalDiff":"Goal Diff","cleanSheets":"Clean Sheets","winRate":"Win Rate","points":"Points","rank":"Position","winStreak":"{count}W Streak","unbeaten":"{count} Unbeaten","groupAll":"All competitions","recentForm":"{count, plural, one {Last match} other {Last # matches}}","playedShort":"P"},"headlines":{"goals":"LFC Goals","assists":"LFC Assists"},"charts":{"scorers":"Top Scorers","assists":"Top Assists","legend":"Premier League {season} · Red = Liverpool player","goalsByMonth":"Goals by Month","goalsByMonthSub":"Scored vs Conceded — all competitions","scored":"Scored","conceded":"Conceded","homeAway":"Home vs Away","homeAwaySub":"Performance comparison","home":"Home","away":"Away","formTimeline":"Form Timeline","formTimelineSub":"{count, plural, one {Last match} other {Last # matches}} · all competitions","win":"Win","draw":"Draw","loss":"Loss","months":{"jan":"Jan","feb":"Feb","mar":"Mar","apr":"Apr","may":"May","jun":"Jun","jul":"Jul","aug":"Aug","sep":"Sep","oct":"Oct","nov":"Nov","dec":"Dec"},"partialMonth":"so far","matchesShort":"matches"},"competitions":{"title":"By Competition","subtitle":"Season {season}","winRate":"Win Rate","gf":"GF","ga":"GA","gfLong":"Goals for","gaLong":"Goals against"},"records":{"title":"Season Records","subtitle":"Season so far","biggestWin":"Biggest Win","biggestLoss":"Biggest Loss","highestScoring":"Highest Scoring","winStreak":"Win Streak","unbeatenStreak":"Unbeaten Streak","comebacks":"Comeback Wins","scoringFirst":"Scoring First Win %","matches":"matches","times":"times"},"table":{"title":"Liverpool scorers in the Premier League","goalsShort":"G","assistsShort":"A","player":"Player","minutesShort":"Min"},"comparison":{"title":"Season Comparison","subtitle":"Compare across recent seasons"},"noData":{"title":"No data for this season yet","description":"There is no match data for this season yet. Check back soon.","action":"See fixtures"},"seasonPicker":"Select season","leaderboard":{"goals":"goals","assists":"assists","rank":"Rank {rank}","tiedRank":"Joint rank {rank}"}},"History":{"metadata":{"title":"The Club","description":"Liverpool FC — 20 league titles, 6 European Cups. Explore the history, stadium, legends, traditions and more."},"hero":{"est":"Established 1892","trophies":"Major Trophies","foundingStory":"Liverpool FC was born from a bitter dispute. In 1892, Everton FC left Anfield over a rent disagreement with their landlord John Houlding. Left with a stadium but no team, Houlding founded Liverpool Football Club on 15 March 1892. The club was admitted to the Football League the following year and won their first league title in 1901. What began as one man's determination to fill an empty stadium has grown into one of the most successful and beloved football clubs in the world.","tagline":"Since 1892 — 20 league titles, 6 European Cups and one Anfield."},"sections":{"profile":"Club Profile","facts":"Key Facts","culture":"Culture","traditions":"Traditions","allTime":"All-Time","records":"Club Records","layout":"Stadium Layout","stands":"The Four Stands","iconic":"Iconic Sites","anfield":"Around Anfield","gallery":"Gallery","photos":"Anfield Photos","glory":"Glory","cabinet":"Trophy Cabinet","history":"History","timeline":"Club Timeline","masterminds":"Masterminds","managers":"Great Managers","immortals":"The Immortals","legends":"Legends","stadiumImages":"Stadium Images"},"facts":{"fullName":"Full Name","founded":"Founded","founder":"Founder","nickname":"Nickname","captain":"Captain","manager":"Manager","owner":"Owner","chairman":"Chairman","league":"League","kitManufacturer":"Kit Manufacturer","website":"Website","colours":"Colours","white":"White"},"tradition":{"listen":"Listen"},"records":{"topScorer":"Top Scorer","goalsCount":"{count} goals","appearances":"Most Appearances","appsCount":"{count} apps","signing":"Record Signing","sale":"Record Sale"},"legends":{"appearances":"Appearances","goals":"Goals","close":"Close"},"stadium":{"fortress":"The Fortress","capacity":"Capacity","opened":"Opened","pitch":"Pitch","record":"Record","seats":"Seats"},"tabs":{"overview":"Overview","anfield":"Anfield","gallery":"Gallery","honours":"Honours","timeline":"Timeline","legends":"Legends"},"nav":{"label":"On this page","timeline":"Timeline","trophies":"Trophies","legends":"Legends","stadium":"Stadium"},"trophies":{"years":"Winning years"},"eras":{"events":"{count, plural, one {# event} other {# events}}","now":"now","beginnings":{"name":"Beginnings","summary":"Founded after Everton left Anfield, Liverpool won their first league titles within a decade and became a First Division fixture."},"shankly":{"name":"The Shankly years","summary":"Bill Shankly arrived with the club in the Second Division and built the modern Liverpool: promotion, titles, the first FA Cup and the Boot Room."},"paisley":{"name":"The glory years","summary":"Under Paisley, Fagan and Dalglish, Liverpool dominated England and Europe, through triumph and the tragedies of Heysel and Hillsborough."},"rebuild":{"name":"Rebuilding","summary":"The Premier League era brought cup runs rather than titles, and two nights that live forever: the 2001 treble of cups and Istanbul in 2005."},"klopp":{"name":"The Klopp years","summary":"Jürgen Klopp turned doubters into believers: a sixth European Cup in 2019 and, in 2020, the league title the club had waited thirty years for."},"today":{"name":"Today","summary":"A new head coach, a new team and the same expectations at Anfield."}}},"About":{"metadata":{"title":"About","description":"Anfield Daily is an unofficial Liverpool fan site that gathers the news from across the English press and sums it up daily. Where the data comes from, and what the site is not."},"label":"About","eyebrow":{"story":"The site","features":"Features","news":"News","ai":"AI","data":"Sources","support":"Chip in"},"title":"Liverpool news, gathered and summed up","disclaimer":"{brand} is an <status>independent, unofficial</status> fan site. It is not affiliated with, sponsored by or endorsed by Liverpool FC, Fenway Sports Group, the Premier League or the news outlets it links to. All names, logos and trademarks belong to their owners.","whatIs":{"title":"What is {brand}?","description":"Anfield Daily is a Liverpool fan’s site for reading the news fast. It gathers stories from across the English press, drops the duplicates and sums up the day in one short briefing, so you don’t have to open twenty tabs. Fixtures, results and the table sit alongside.","featuresTitle":"What's on the site","features":{"gathered":{"title":"Gathered news","body":"Stories from across the English press in one feed, each with a link to the original."},"dedupe":{"title":"No duplicates","body":"The same story from five outlets shows up once, not five times."},"digest":{"title":"Daily briefing","body":"The day’s stories in one short briefing, drafted by AI, so you can catch up fast."},"fixtures":{"title":"Fixtures & results","body":"Kick-off times in your time zone and results: Premier League, Champions League, FA Cup, EFL Cup."},"spoiler":{"title":"Spoiler-free","body":"Hide scores and results across the site until you choose to see them. Handy for replays."},"calendar":{"title":"Calendar sync","body":"Every Liverpool match in your phone’s calendar at your local time, with a reminder before kick-off."},"predictions":{"title":"Predictions & ratings","body":"Predict the score, rate the players and see how you rank against other fans. Sign-in required."},"club":{"title":"Squad & club","body":"The squad with a profile for each player, league tables, club history and Anfield. An optional account saves your favourites."}},"dataTitle":"Data sources","dataSources":"Fixtures, results, tables: football-data.org and ESPN. Player stats: Fantasy Premier League (public API). Squad and player profiles: liverpoolfc.com. Headlines: public RSS feeds from English outlets, always with a link to the original story.","techTitle":"Tech Stack","techStack":"Next.js 16 (App Router, ISR) · React 19 · TypeScript · Tailwind CSS 4 · shadcn/ui · Framer Motion · Recharts · Supabase (Auth + PostgreSQL + Storage) · next-intl (EN/VI)"},"creator":{"title":"Who makes this","role":"Developer, Liverpool fan","bio":"I'm a developer and a Liverpool fan. Anfield Daily is a spare-time project for reading the day's Liverpool news fast, without hunting through every outlet."},"contact":{"title":"Contact","description":"Feedback, a bug, or a content correction? Just message me.","email":"Email","github":"GitHub","githubUrl":"https://github.com/dangdinh87","phone":"Phone"},"support":{"title":"Support the site","description":"{brand} is free. If it's useful to you, a coffee helps me cover hosting and API costs.","buyCoffee":"Buy me a coffee","momoAlt":"MoMo QR - Nguyen Dang Dinh","momoTitle":"MoMo QR code"},"tagline":"Quick news, a daily summary, fixtures and results for Liverpool fans.","news":{"title":"How news is handled","body":"Quick news shows only the headline, a short excerpt and a link to the original story. To read the full piece, open it on the publisher's own site. {brand} does not republish full articles. If you are the author or publisher and want an item changed or removed, email me and I will review it."},"ai":{"title":"AI on {brand}","body":"Reds AI (chat), translation of news excerpts and the daily digest are AI-assisted. AI can be wrong or out of date. For anything important, such as kick-off times or tickets, check the club's official channels."}},"Standings":{"metadata":{"title":"Standings","description":"Premier League table {season}: points, goal difference, form and where Liverpool stand."},"hero":{"season":"Premier League · {season}","title":"Standings","lfcPosition":"Liverpool FC · {rank}{suffix} place","points":"{count} points","suffixes":{"st":"st","nd":"nd","rd":"rd","th":"th"}},"rank":"#","club":"Club","played":"P","win":"W","draw":"D","lose":"L","gf":"GF","ga":"GA","gd":"GD","pts":"Pts","form":"Form","progressBar":{"label":"Liverpool"},"zones":{"cl":"Champions League","el":"Europa League","ecl":"Conference League","rel":"Relegation","r16":"Round of 16","playoff":"Play-off round","elim":"Eliminated"},"description":"The latest Premier League table.","compLabel":"Competition","outage":{"title":"The table is unavailable","description":"We could not load the table. Please try again in a few minutes.","action":"Read quick news"},"summary":{"label":"Liverpool in the table","position":"Position in the table","leading":"Top of the table","behindLeader":"{count, plural, one {point} other {points}} behind the leader","topFourClear":"{count, plural, one {point} other {points}} clear in the top four","topFourBehind":"{count, plural, one {point} other {points}} off the top four","aboveDrop":"{count, plural, one {point} other {points}} above the drop","next":"Next league match: <b>{team}</b>, {rank, selectordinal, one {#st} two {#nd} few {#rd} other {#th}} on {points} pts.","matchLink":"Match page"},"nextBadge":"Next"},"Fixtures":{"metadata":{"title":"Liverpool fixtures & results","description":"Liverpool kick-off times in your local time, results and rounds for the {season} season."},"hero":{"season":"{season} Season","title":"Fixtures & results","subtitle":"{count} matches this season · your local time"},"timeline":{"filter":{"all":"All competitions"},"tabs":{"upcoming":"Upcoming","recent":"Recently Played","results":"Results"},"sections":{"upcoming":"Upcoming","recent":"Recently Played","results":"Results"},"noFixtures":"No upcoming matches in this competition.","viewLabel":"Fixtures view","filterLabel":"Filter by competition","gmtHint":"Kick-off times are shown in your local time ({zone}).","emptyTitle":"No matches yet","noResults":"No finished matches for this competition yet.","archive":"Past seasons","plWatch":"Where to watch depends on your country; match pages show the broadcaster where one is known.","zoneChip":"Your time · {zone}","later":"Later fixtures","matchCount":"{count, plural, one {# match} other {# matches}}"},"detail":{"back":"Back to fixtures","matchTimeline":"Match Timeline","statistics":"Statistics","lineups":"Lineups","lineupsConfirmed":"Confirmed","lineupsPredicted":"Predicted","substitutes":"Substitutes","coach":"Coach","noData":"The timeline and statistics appear once the match starts.","empty":{"afterKickoff":"Available once the match starts.","events":{"title":"No match events yet","description":"Goals, cards and substitutions are not available for this match."},"stats":{"title":"No statistics yet","description":"The data provider has no statistics for this match."},"lineups":{"title":"Lineups not announced","description":"Team sheets usually appear about an hour before kick-off."},"h2h":{"title":"No head-to-head data","description":"We have no recent meetings with this opponent."}},"kickoffVn":"Kick-off","sectionsLabel":"Match sections","metaUpcoming":"{home} vs {away}: kick-off {time}, {date} (UK time). {competition}. Where to watch, lineups and head to head.","metaFinished":"{home} {homeGoals}-{awayGoals} {away}. {competition}: match timeline, statistics and lineups.","attendance":"{count} in attendance","referee":"Referee: {name}"},"outage":{"title":"Fixtures are taking a break","description":"We could not load the match schedule right now. Please try again in a few minutes.","action":"Read quick news"},"nav":{"label":"Match centre","fixtures":"Fixtures","results":"Results","standings":"Table","stats":"Stats"},"calendar":{"button":"Add to calendar","hint":"Every Liverpool match in your phone’s calendar, at your local time, with a reminder 30 minutes before. It updates itself when a kick-off moves.","google":"Google Calendar","apple":"Apple Calendar (iPhone, Mac)","outlook":"Outlook","copy":"Copy calendar link","copied":"Link copied","calendarName":"Liverpool fixtures"}},"Legal":{"metadata":{"title":"Legal","description":"{brand}'s privacy policy, terms of use and data sources. An unofficial Liverpool fan site."},"title":"Legal Information","lastUpdated":"Last updated: {date}","contact":"For questions or concerns, contact <email>nguyendangdinh47@gmail.com</email>","labels":{"privacy":"Privacy Policy","terms":"Terms of Use"},"sections":{"privacy":{"title":"Privacy Policy","content":"{brand} is an independent project and is not affiliated with Liverpool Football Club or Fenway Sports Group. We do not collect personal data beyond what is necessary for account functionality (email, username, avatar). Authentication is handled securely via Supabase. AI chat conversations are stored for continuity but are not shared externally. Gallery images are hosted on Cloudinary. We do not sell or share your data with third parties. The site shows Google AdSense ads; Google and its partners may use cookies to serve ads, and you can turn off personalised ads in your Google ad settings."},"terms":{"title":"Terms of Use","content":"This site is provided as-is for informational and entertainment purposes only. {brand} is an unofficial fan site and is not affiliated with Liverpool FC or the Premier League. All Liverpool FC trademarks, logos, and brand elements are the property of Liverpool Football Club and Athletic Grounds Limited. Match data is sourced from Football-Data.org and ESPN. Quick news shows only the headline, a short excerpt and a link to the original story; all rights in an article belong to the original publisher or author, and {brand} does not republish full articles. AI features (chat, translation, daily digest) are powered by VietAPI, with Groq for live web search. Use of this site constitutes acceptance of these terms."},"sources":{"title":"Data Sources","content":"League standings, fixtures and results are provided by Football-Data.org. Cup fixtures and match events are supplemented by ESPN. Player stats come from the Fantasy Premier League (public API); the squad and player profiles come from liverpoolfc.com. Quick news takes headlines and short excerpts from the publishers' public RSS feeds, with a link to the original story — Sources are LFC Official, BBC Sport, The Guardian, Liverpool Echo, This Is Anfield, Anfield Watch, Empire of the Kop, Sky Sports, The Mirror, The Independent, Anfield Index, Liverpool.com and ESPN. AI chat, article translation and the daily digest are powered by VietAPI; the daily digest is drafted by AI and may contain mistakes. Live web search in chat uses Groq. Gallery images are hosted on Cloudinary. Historical data and trophy information are maintained by the site administrators based on publicly available records."}},"toc":"On this page"},"Auth":{"login":{"title":"Welcome Back","subtitle":"Sign in to save favourite players and articles and use Reds AI.","email":"Email Address","password":"Password","button":"Sign In","loading":"Signing in...","noAccount":"Don't have an account?","register":"Register here","error":"Invalid login credentials","google":"Continue with Google","showPassword":"Show password","hidePassword":"Hide password","close":"Close","or":"or"},"register":{"title":"Join the Reds","subtitle":"A free account to save favourite players and articles.","username":"Username","email":"Email Address","password":"Password","button":"Create Account","loading":"Creating account...","hasAccount":"Already have an account?","login":"Sign in here","error":"Failed to create account","confirm":"Confirm Password","confirmMismatch":"Passwords do not match","passwordShort":"Password must be at least 6 characters","checkEmail":"Confirmation email sent. Open it (check spam too) and tap the link to finish signing up.","passwordHint":"At least 6 characters."},"errors":{"unavailable":"Sign-in is temporarily unavailable. Please try again in a few minutes.","invalidCredentials":"Incorrect email or password.","emailNotConfirmed":"Please confirm your email first — check your inbox.","userExists":"An account with this email already exists. Try signing in.","weakPassword":"That password is too weak. Use a longer, less common one.","rateLimited":"Too many attempts. Please wait a moment and try again.","emailRequired":"Please enter your email.","emailInvalid":"Enter a valid email address.","pass