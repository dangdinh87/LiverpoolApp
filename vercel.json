{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ]; then exit 1; else exit 0; fi",
  "crons": [
    { "path": "/api/news/cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/news/digest/generate", "schedule": "0 0 * * *" }
  ]
}
