# Supabase — get from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — only used server-side, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Football-Data.org — get from https://www.football-data.org (free registration)
# Free tier: 10 req/min, PL standings with W/D/L/GF/GA/form
FOOTBALL_DATA_ORG_KEY=your-football-data-org-key-here

# Public site URL — used for sitemap, metadataBase, OAuth redirects
NEXT_PUBLIC_SITE_URL=https://anfielddaily.com

# Groq API — used for LFC Chat AI assistant + article translation
GROQ_API_KEY=your-groq-api-key-here


# Cron secret — protects /api/news/sync endpoint (generate a random string)
# YouTube Data API v3 — the club's video output for the strip on /news.
# Optional: without it the video source is skipped and the strip hides itself.
# Needed because YouTube's RSS feed is disabled for that channel (and for every
# LFC fan channel checked on 2026-10-12). The free quota is 10,000 units/day and
# the hourly sync spends 24, so no billing is required.
# Create one at https://console.cloud.google.com/apis/credentials with the
# YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

CRON_SECRET=your-cron-secret-here

# Cloudinary — used for gallery image hosting (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# VietAPI (OpenAI-compatible LLM proxy) — chat, translation, digest: https://vietapi.tech
VIETAPI_KEY=

# Google AdSense — publisher ID. Optional: the app falls back to the committed
# default. Set empty to disable ads; set to another ca-pub-… for a different site.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
